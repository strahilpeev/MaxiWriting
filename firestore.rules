rules_version = '2';
// Правила за сигурност на базата (Firebase Console → Firestore → Rules → Publish).
//
// Всеки акаунт (родител / специалист) вижда и променя САМО своите данни:
//   accounts/{uid}                     — самият акаунт
//   accounts/{uid}/profiles/{id}       — децата в акаунта
// Полетата за абонамент (plan, subscription, …) не могат да се пишат от
// приложението — по-късно ще ги попълва системата за плащания.
service cloud.firestore {
  match /databases/{database}/documents {

    // Собственикът на приложението — само той може да пренесе старите
    // профили от общата база. Имейлът трябва да е потвърден (или вход с Google).
    function isOwnerOfApp() {
      return request.auth != null
        && request.auth.token.email == 'strahil.peev@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isMe(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /accounts/{uid} {
      allow read: if isMe(uid);
      // Приложението пише само тези полета; всичко останало (план, абонамент)
      // се управлява от сървъра.
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['email', 'createdAt']);
      allow update: if isMe(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email']);
      allow delete: if false;

      match /profiles/{profileId} {
        allow read: if isMe(uid);
        allow create, update: if isMe(uid)
          && profileId.size() < 100
          && request.resource.data.keys().size() < 40
          && (!('name' in request.resource.data) || request.resource.data.name is string)
          && (!('name' in request.resource.data) || request.resource.data.name.size() <= 40);
        allow delete: if false; // приложението само маркира deleted:true
      }
    }

    // Старата обща база отпреди акаунтите — само за четене от собственика,
    // за да може да пренесе децата си в своя акаунт. Никой не може да пише там.
    match /profiles/{profileId} {
      allow read: if isOwnerOfApp();
      allow write: if false;
    }
    // Общо класиране: само прякор, аватар, ниво и звезди (без истинско име).
    // Чете всеки вписан родител/специалист; пише само акаунтът, чийто uid е
    // в началото на името на записа ({uid}_{profileId}).
    match /leaderboard/{entryId} {
      allow read: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow create, update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && entryId.matches(request.auth.uid + '_[A-Za-z0-9_-]{1,80}')
        && request.resource.data.keys().hasOnly(['uid', 'nick', 'avatar', 'level', 'stars', 'score', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 40
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 16
        && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 1000
        && request.resource.data.stars is int && request.resource.data.stars >= 0
        && request.resource.data.score == request.resource.data.level * 1000000 + request.resource.data.stars;
      allow delete: if request.auth != null
        && entryId.matches(request.auth.uid + '_[A-Za-z0-9_-]{1,80}');
    }
    match /settings/{doc} {
      allow read, write: if false;
    }

    // Всичко останало е забранено.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
